{
  "name": "shelfit",
  "private": true,
  "description": "Monorepo for the shelfit family of CLI tools — list what you've built, per platform.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/my-shelfio/shelfit.git"
  },
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "npm test --workspaces --if-present",
    "changeset": "changeset",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@changesets/cli": "^2.31.1",
    "@vitest/coverage-v8": "^4.1.10",
    "vitest": "^4.1.10"
  }
}
