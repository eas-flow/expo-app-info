{
  "name": "expo-app-info",
  "version": "0.3.0",
  "description": "List every Expo (EAS) app in your account with its latest build version per platform — from any directory.",
  "keywords": [
    "expo",
    "eas",
    "eas-cli",
    "react-native",
    "cli",
    "npx",
    "version",
    "app-version",
    "build",
    "build-number",
    "monorepo",
    "devtools"
  ],
  "license": "MIT",
  "author": "it0 (https://github.com/eas-flow/expo-app-info)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eas-flow/expo-app-info.git"
  },
  "bugs": {
    "url": "https://github.com/eas-flow/expo-app-info/issues"
  },
  "homepage": "https://github.com/eas-flow/expo-app-info#readme",
  "type": "module",
  "bin": {
    "expo-app-info": "bin/cli.mjs"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node bin/cli.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "format": "biome format --write .",
    "changeset": "changeset"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@changesets/cli": "^2.31.1",
    "@vitest/coverage-v8": "^4.1.10",
    "vitest": "^4.1.10"
  }
}
